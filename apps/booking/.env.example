# 第一次啟動時建立的場主帳號（用手機號碼＋密碼登入，登入後會直接進入場主後台）
BOOKING_OWNER_NAME=場主
BOOKING_OWNER_PHONE=0900000000
BOOKING_OWNER_PASSWORD=請改成強密碼
# 設為 1 會在資料庫是空的時候放入示範課程、老師與課卡方案；正式上線請設為 0
BOOKING_SEED_DEMO=0
BOOKING_TZ=Asia/Taipei
# DUPR 合作夥伴金鑰（選填）
DUPR_CLIENT_KEY=
DUPR_CLIENT_SECRET=
DUPR_ENV=production
# LINE Login（選填）：LINE Developers 建立 LINE Login channel，Callback URL 設為 https://<網域>/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# 要讓使用者在 LINE 裡開啟時自動登入，建立 LIFF app（Endpoint URL 設為網站首頁）後填入
LINE_LIFF_ID=
